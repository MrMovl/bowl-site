FROM elixir:1.17-alpine

RUN apk add --no-cache \
  build-base \
  git \
  inotify-tools \
  imagemagick \
  nodejs \
  npm

WORKDIR /app

RUN mix local.hex --force && mix local.rebar --force

EXPOSE 4000

# Deps are installed by the compose entrypoint command, not baked in,
# so the volume-mounted source tree is always in sync.
CMD ["mix", "phx.server"]
