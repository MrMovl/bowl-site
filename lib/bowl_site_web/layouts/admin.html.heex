<!DOCTYPE html>
<html lang="de" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title suffix=" · Admin">
      <%= assigns[:page_title] || "Admin" %>
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
  </head>
  <body class="h-full bg-stone-100">
    <div class="flex h-full">
      <!-- Sidebar -->
      <aside class="w-56 bg-white border-r border-stone-200 flex flex-col">
        <div class="p-4 border-b border-stone-200">
          <a href={~p"/"} class="text-sm font-semibold text-stone-800">← Drechslerei</a>
        </div>
        <nav class="flex-1 p-4 space-y-1">
          <a href={~p"/admin"} class="block px-3 py-2 rounded text-sm text-stone-700 hover:bg-stone-100">
            Dashboard
          </a>
          <a href={~p"/admin/products"} class="block px-3 py-2 rounded text-sm text-stone-700 hover:bg-stone-100">
            Produkte
          </a>
          <a href={~p"/admin/pages"} class="block px-3 py-2 rounded text-sm text-stone-700 hover:bg-stone-100">
            Seiten
          </a>
        </nav>
        <div class="p-4 border-t border-stone-200">
          <.form action={~p"/admin/logout"} method="delete">
            <button type="submit" class="text-xs text-stone-400 hover:text-stone-700">
              Abmelden
            </button>
          </.form>
        </div>
      </aside>

      <!-- Main content -->
      <div class="flex-1 flex flex-col min-w-0">
        <main class="flex-1 p-6 overflow-auto">
          <.flash_group flash={@flash} />
          <%= @inner_content %>
        </main>
      </div>
    </div>
  </body>
</html>
