<!-- Hero -->
<section class="bg-stone-100 border-b border-stone-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-28 flex flex-col items-center text-center">
    <h1 class="text-4xl md:text-5xl font-light tracking-wide text-stone-800 mb-6">
      <%= if @locale == "de" do %>
        Handgedrechselte Objekte
      <% else %>
        Handturned Objects
      <% end %>
    </h1>
    <p class="text-lg text-stone-600 max-w-xl mb-10">
      <%= if @locale == "de" do %>
        Unikate aus der Drechselwerkstatt — Schalen, Tassen und mehr,
        gefertigt mit Leidenschaft und Sorgfalt.
      <% else %>
        One-of-a-kind pieces from the lathe — bowls, mugs, and more,
        crafted with passion and care.
      <% end %>
    </p>
    <a
      href={~p"/shop"}
      class="bg-stone-800 text-white px-6 py-3 rounded text-sm font-medium hover:bg-stone-700 transition-colors"
    >
      <%= if @locale == "de", do: "Zur Galerie", else: "View Gallery" %>
    </a>
  </div>
</section>

<!-- Featured products -->
<%= if @featured != [] do %>
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <h2 class="text-2xl font-light text-stone-800 mb-8">
      <%= if @locale == "de", do: "Ausgewählte Stücke", else: "Featured Pieces" %>
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <%= for product <- @featured do %>
        <.product_card product={product} locale={@locale} />
      <% end %>
    </div>
    <div class="mt-10 text-center">
      <a href={~p"/shop"} class="text-stone-600 hover:text-stone-900 text-sm underline">
        <%= if @locale == "de", do: "Alle Stücke ansehen →", else: "View all pieces →" %>
      </a>
    </div>
  </section>
<% end %>

<!-- About teaser -->
<section class="bg-stone-50 border-t border-stone-200">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 text-center">
    <p class="text-stone-600 text-lg leading-relaxed">
      <%= if @locale == "de" do %>
        Jedes Stück entsteht auf der Drehbank — ein Hobby, das zur Leidenschaft wurde.
        Kein Stück ist wie das andere. Bei Interesse einfach per E-Mail melden.
      <% else %>
        Every piece is turned on the lathe — a hobby that became a passion.
        No two pieces are alike. Interested? Just drop me an email.
      <% end %>
    </p>
    <a
      href={"mailto:kontakt@beispiel.de"}
      class="mt-6 inline-block text-stone-500 hover:text-stone-800 text-sm"
    >
      kontakt@beispiel.de
    </a>
  </div>
</section>
