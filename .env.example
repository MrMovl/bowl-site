# Copy this file to .env and fill in the values before starting production.
# Never commit .env to version control.

# PostgreSQL
POSTGRES_USER=bowl_site
POSTGRES_PASSWORD=change_me_please
POSTGRES_DB=bowl_site_prod

# Phoenix — generate SECRET_KEY_BASE with: mix phx.gen.secret
SECRET_KEY_BASE=run_mix_phx_gen_secret_and_paste_here

# Your public domain (no https://, no trailing slash)
PHX_HOST=yourdomain.com

# Admin account created on first boot via seeds (must be >= 12 chars)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change_me_please_min_12_chars
