# Copy to .env and fill in values before running

# Payload — must be at least 32 characters, change before use
PAYLOAD_SECRET=replace-with-32-char-minimum-random-string

# Database
# For local dev (npm run dev): use localhost
DATABASE_URI=postgresql://postgres:changeme@localhost:5432/bowlsite
# For full Docker (docker compose up --build): use db
# DATABASE_URI=postgresql://postgres:changeme@db:5432/bowlsite
POSTGRES_DB=bowlsite
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# App — base URL shown in admin and used for image URLs
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
