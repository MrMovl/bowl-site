# Copy to .env and fill in values before running

# Payload — change to a random 32+ character string before going to production
PAYLOAD_SECRET=replace-with-32-char-minimum-random-string

# Database — "db" is the postgres container hostname inside Docker Compose
DATABASE_URI=postgresql://postgres:changeme@db:5432/bowlsite
POSTGRES_DB=bowlsite
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# App — base URL used for image URLs and the admin panel
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
